<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AuraConnect.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AuraConnect">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Theme/AuraStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Oxanium Font Family -->
            <FontFamily x:Key="OxaniumFont">ms-appx:///Assets/Fonts/Oxanium-VariableFont_wght.ttf#Oxanium</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
