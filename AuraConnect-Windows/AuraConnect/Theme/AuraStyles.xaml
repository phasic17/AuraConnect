<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Family -->
    <FontFamily x:Key="OxaniumFont">ms-appx:///Assets/Fonts/Oxanium-VariableFont_wght.ttf#Oxanium</FontFamily>

    <!-- Brand Colors -->
    <Color x:Key="AuraBlueColor">#FF1F9EFF</Color>
    <Color x:Key="AuraCyanColor">#FF1AD9FF</Color>
    <Color x:Key="Bg0Color">#FF000000</Color>
    <Color x:Key="PanelTintColor">#09FFFFFF</Color>
    <Color x:Key="StrokeColor">#1AFFFFFF</Color>
    <Color x:Key="TextDimColor">#B3FFFFFF</Color>
    <Color x:Key="TextDim2Color">#85FFFFFF</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="AuraBlueBrush" Color="{StaticResource AuraBlueColor}" />
    <SolidColorBrush x:Key="AuraCyanBrush" Color="{StaticResource AuraCyanColor}" />
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="PanelTintBrush" Color="{StaticResource PanelTintColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextDim2Brush" Color="{StaticResource TextDim2Color}" />

    <!-- Glass Panel Border Gradient -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38FFFFFF" Offset="0.0" />
        <GradientStop Color="#2E1F9EFF" Offset="0.33" />
        <GradientStop Color="#00000000" Offset="0.66" />
        <GradientStop Color="#1FFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Sidebar Gradient -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF26262E" Offset="0.0" />
        <GradientStop Color="#FF0D0D0F" Offset="0.5" />
        <GradientStop Color="#FF1F1F24" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Text Styles -->
    <Style x:Key="AuraTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="130" />
        <Setter Property="Foreground" Value="{StaticResource AuraBlueBrush}" />
    </Style>

    <Style x:Key="AuraSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="AuraBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="AuraLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Card Background Style -->
    <Style x:Key="AuraCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="BorderBrush" Value="#14FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Override dark theme defaults -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Black" />

    <!-- Button Styles -->
    <Style x:Key="AuraPillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#DCFFFFFF" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#401F9EFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Sidebar Navigation Button -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Opacity" Value="0.74" />
        <Setter Property="FontFamily" Value="{StaticResource OxaniumFont}" />
    </Style>
</ResourceDictionary>
