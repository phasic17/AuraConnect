<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AuraConnect.Controls.AuraHeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="68">

    <Grid>
        <!-- Glass background -->
        <Border CornerRadius="18">
            <Border.Background>
                <AcrylicBrush TintColor="#000000"
                              TintOpacity="0.65"
                              FallbackColor="#09FFFFFF" />
            </Border.Background>
        </Border>

        <!-- Panel tint -->
        <Border CornerRadius="18" Background="#09FFFFFF" />

        <!-- Border stroke -->
        <Border CornerRadius="18"
                BorderThickness="1"
                BorderBrush="#381F9EFF" />

        <!-- Animated scan sweep -->
        <Border CornerRadius="18" x:Name="SweepContainer">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="#2E1F9EFF" Offset="0.5" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Content -->
        <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="TitleBlock"
                           Style="{StaticResource AuraTitleStyle}"
                           Foreground="{StaticResource AuraBlueBrush}" />
                <TextBlock x:Name="SubtitleBlock"
                           Style="{StaticResource AuraBodyStyle}"
                           Foreground="{StaticResource TextDimBrush}"
                           MaxLines="1" />
            </StackPanel>

            <FontIcon Grid.Column="1"
                      Glyph="&#xE734;"
                      FontSize="18"
                      Foreground="{StaticResource AuraCyanBrush}"
                      VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
