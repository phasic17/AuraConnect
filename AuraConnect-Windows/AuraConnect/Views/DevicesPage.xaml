<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuraConnect.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="18">
        <StackPanel Spacing="16" MaxWidth="920">

            <!-- Top bar (glass panel) -->
            <Border CornerRadius="18" Padding="16" BorderThickness="1"
                    BorderBrush="{StaticResource GlassBorderBrush}">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.65" FallbackColor="#09FFFFFF" />
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="DEVICES"
                                   Style="{StaticResource AuraSectionTitleStyle}" />
                        <TextBlock Text="Radar view. Shows nearby Aura Pucks in Transfer Mode."
                                   Style="{StaticResource AuraBodyStyle}" />
                        <TextBlock Text="To send files: go to TRANSFER, choose a puck, then CONNECT."
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" CharacterSpacing="30"
                                   Foreground="#80FFFFFF" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Top">
                        <Button x:Name="ScanButton" Click="OnScanClick"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE704;" FontSize="13" />
                                <TextBlock Text="SCAN" Style="{StaticResource AuraLabelStyle}" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="OnStopClick"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="13" />
                                <TextBlock Text="STOP" Style="{StaticResource AuraLabelStyle}" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device list (glass panel) -->
            <Border CornerRadius="18" Padding="16" BorderThickness="1"
                    BorderBrush="{StaticResource GlassBorderBrush}">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.65" FallbackColor="#09FFFFFF" />
                </Border.Background>

                <StackPanel x:Name="DeviceListPanel" Spacing="10">
                    <TextBlock x:Name="EmptyLabel"
                               Text="NO DEVICES FOUND. PUT THE PUCK INTO TRANSFER MODE AND SCAN."
                               FontFamily="{StaticResource OxaniumFont}"
                               FontSize="12" CharacterSpacing="40"
                               Foreground="#A6FFFFFF" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
