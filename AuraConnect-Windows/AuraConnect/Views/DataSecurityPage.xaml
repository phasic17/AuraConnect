<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuraConnect.Views.DataSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="18">
        <StackPanel Spacing="16">

            <!-- Header -->
            <Border CornerRadius="18" Padding="16" BorderThickness="1"
                    BorderBrush="{StaticResource GlassBorderBrush}">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.65" FallbackColor="#09FFFFFF" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <TextBlock Text="DATA SECURITY"
                               FontFamily="{StaticResource OxaniumFont}"
                               FontSize="20" FontWeight="SemiBold"
                               CharacterSpacing="70"
                               Foreground="#EBFFFFFF" />
                    <TextBlock Text="Emergency fleet controls. Placeholder UI for instantly bricking a device if compromised."
                               FontFamily="{StaticResource OxaniumFont}" FontSize="13"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Border>

            <!-- Device list + Action panel -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- Device list -->
                <Border Grid.Column="0" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEVICES"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55"
                                   Foreground="#99FFFFFF" />
                        <StackPanel x:Name="DeviceListPanel" Spacing="4" />
                    </StackPanel>
                </Border>

                <!-- Action panel -->
                <Border Grid.Column="1" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ACTIONS"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55"
                                   Foreground="#99FFFFFF" />
                        <TextBlock Text="These actions are placeholders. No real device commands are sent yet."
                                   FontFamily="{StaticResource OxaniumFont}" FontSize="12"
                                   Foreground="#8CFFFFFF" TextWrapping="Wrap" MaxLines="3" />

                        <Border Height="1" Background="#26FFFFFF" />

                        <ToggleSwitch Header="Require confirmation phrase" IsOn="True"
                                      OnContent="" OffContent="" />

                        <Button x:Name="LockDeviceButton"
                                Style="{StaticResource AuraPillButtonStyle}"
                                Content="LOCK DEVICE" IsEnabled="False" />

                        <Button x:Name="BrickButton"
                                Content="BRICK NOW" IsEnabled="False"
                                Foreground="#EBFFFFFF"
                                BorderBrush="#73FF0000"
                                Background="#1AFFFFFF"
                                CornerRadius="16"
                                Padding="12,8"
                                FontFamily="{StaticResource OxaniumFont}"
                                FontSize="11" FontWeight="Medium" />

                        <TextBlock x:Name="SelectedDeviceLabel" Text="No device selected."
                                   FontFamily="{StaticResource OxaniumFont}" FontSize="12"
                                   Foreground="#8CFFFFFF" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
