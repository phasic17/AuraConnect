<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuraConnect.Views.AiModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="18">
        <StackPanel Spacing="16">

            <!-- Header -->
            <Border CornerRadius="18" Padding="16" BorderThickness="1"
                    BorderBrush="{StaticResource GlassBorderBrush}">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.65" FallbackColor="#09FFFFFF" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <TextBlock Text="AURA AI MODULES"
                               FontFamily="{StaticResource OxaniumFont}"
                               FontSize="20" FontWeight="SemiBold"
                               CharacterSpacing="70"
                               Foreground="#EBFFFFFF" />
                    <TextBlock Text="Download Domain Specific Aura AI models"
                               FontFamily="{StaticResource OxaniumFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Border>

            <!-- How it works strip -->
            <Border CornerRadius="18" Padding="12"
                    Background="#09FFFFFF"
                    BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE896;"
                              FontSize="16" Foreground="{StaticResource AuraBlueBrush}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               Text="Choose modules, download, then drag &amp; drop onto your Puck to install specialty intelligence."
                               FontFamily="{StaticResource OxaniumFont}" FontSize="12"
                               Foreground="#ADFFFFFF" TextWrapping="Wrap" MaxLines="2"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="2" CornerRadius="12" Padding="10,6"
                            Background="#0FFFFFFF"
                            BorderBrush="#1AFFFFFF" BorderThickness="1"
                            Margin="10,0,0,0">
                        <TextBlock Text="LOCAL-FIRST"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium"
                                   CharacterSpacing="50"
                                   Foreground="#BFFFFFFF" />
                    </Border>
                </Grid>
            </Border>

            <!-- Module list -->
            <StackPanel x:Name="ModuleListPanel" Spacing="12" />

        </StackPanel>
    </ScrollViewer>
</Page>
