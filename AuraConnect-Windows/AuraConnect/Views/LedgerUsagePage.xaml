<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuraConnect.Views.LedgerUsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AuraConnect.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="18">
        <StackPanel Spacing="16">

            <!-- Header -->
            <Border CornerRadius="18" Padding="16" BorderThickness="1"
                    BorderBrush="{StaticResource GlassBorderBrush}">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000" TintOpacity="0.65" FallbackColor="#09FFFFFF" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <TextBlock Text="LEDGER USAGE"
                               FontFamily="{StaticResource OxaniumFont}"
                               FontSize="20" FontWeight="SemiBold"
                               CharacterSpacing="70"
                               Foreground="#EBFFFFFF" />
                    <TextBlock Text="Monitor usage across Aura Pucks and Farsight devices. Allocate $LEDGER by device and keep the fleet funded."
                               FontFamily="{StaticResource OxaniumFont}" FontSize="13"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Border>

            <!-- Metrics row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOTAL BALANCE" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="TotalBalanceText" Text="125,000 $LEDGER"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#EBFFFFFF" />
                        <TextBlock Text="Across fleet" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="12" Foreground="#8CFFFFFF" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ALLOCATED" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="AllocatedText" Text="66,500 $LEDGER"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#EBFFFFFF" />
                        <TextBlock Text="Reserved to devices" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="12" Foreground="#8CFFFFFF" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="REMAINING" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="RemainingText" Text="58,500 $LEDGER"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#EBFFFFFF" />
                        <TextBlock Text="Available to allocate" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="12" Foreground="#8CFFFFFF" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Chart row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- System Usage Chart -->
                <Border Grid.Column="0" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SYSTEM USAGE &#x2022; LAST 7 DAYS"
                                       FontFamily="{StaticResource OxaniumFont}"
                                       FontSize="11" FontWeight="Medium" CharacterSpacing="55"
                                       Foreground="#99FFFFFF" />
                            <TextBlock x:Name="AvgDailyText" Grid.Column="1"
                                       FontFamily="{StaticResource OxaniumFont}"
                                       FontSize="11" FontWeight="Medium" CharacterSpacing="50"
                                       Foreground="#B8FFFFFF" />
                        </Grid>
                        <controls:AuraLineChart x:Name="SystemChart" Height="140" />
                        <TextBlock Text="Placeholder: total compute/model usage billed against $LEDGER."
                                   FontFamily="{StaticResource OxaniumFont}" FontSize="12"
                                   Foreground="#8CFFFFFF" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>

                <!-- Fleet Summary -->
                <Border Grid.Column="1" Style="{StaticResource AuraCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FLEET SUMMARY"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55"
                                   Foreground="#99FFFFFF" />

                        <Grid><Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="DEVICES MANAGED" FontFamily="{StaticResource OxaniumFont}" FontSize="10" FontWeight="Medium" CharacterSpacing="50" Foreground="#8CFFFFFF" />
                            <TextBlock Grid.Column="1" x:Name="DeviceCountText" FontFamily="{StaticResource OxaniumFont}" FontSize="12" FontWeight="Medium" Foreground="#D9FFFFFF" />
                        </Grid>
                        <Grid><Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="AVG DAILY USAGE" FontFamily="{StaticResource OxaniumFont}" FontSize="10" FontWeight="Medium" CharacterSpacing="50" Foreground="#8CFFFFFF" />
                            <TextBlock Grid.Column="1" x:Name="AvgDailySummaryText" FontFamily="{StaticResource OxaniumFont}" FontSize="12" FontWeight="Medium" Foreground="#D9FFFFFF" />
                        </Grid>
                        <Grid><Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="USAGE TREND" FontFamily="{StaticResource OxaniumFont}" FontSize="10" FontWeight="Medium" CharacterSpacing="50" Foreground="#8CFFFFFF" />
                            <TextBlock Grid.Column="1" Text="&#x25B2; steady" FontFamily="{StaticResource OxaniumFont}" FontSize="12" FontWeight="Medium" Foreground="#D9FFFFFF" />
                        </Grid>

                        <Border CornerRadius="12" Padding="10,6"
                                Background="#14FFFFFF" BorderBrush="#401F9EFF" BorderThickness="1"
                                HorizontalAlignment="Left" Margin="0,12,0,0">
                            <TextBlock Text="MANAGER MODE"
                                       FontFamily="{StaticResource OxaniumFont}"
                                       FontSize="11" FontWeight="Medium" CharacterSpacing="50"
                                       Foreground="#C7FFFFFF" />
                        </Border>
                        <TextBlock Text="Allocate budget per device below."
                                   FontFamily="{StaticResource OxaniumFont}" FontSize="12"
                                   Foreground="#8CFFFFFF" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device budget table -->
            <Border Style="{StaticResource AuraCardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DEVICES" FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="55" Foreground="#99FFFFFF" />
                        <TextBlock Grid.Column="1" Text="ALLOCATE $LEDGER"
                                   FontFamily="{StaticResource OxaniumFont}"
                                   FontSize="11" FontWeight="Medium" CharacterSpacing="50" Foreground="#B3FFFFFF" />
                    </Grid>
                    <StackPanel x:Name="DeviceBudgetPanel" Spacing="8" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
